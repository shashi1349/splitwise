# Active profile: dev (in-memory H2, default) or prod (Postgres).
SPRING_PROFILES_ACTIVE=dev

# JWT signing secret (HS256). Must be at least 32 ASCII chars in production.
JWT_SECRET=change-me-please-this-must-be-at-least-32-bytes-for-hs256-signing

# CORS — origin of the frontend that may call this API.
APP_FRONTEND_ORIGIN=http://localhost:5173

# Production-only: PostgreSQL connection.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/splitwise
SPRING_DATASOURCE_USERNAME=splitwise
SPRING_DATASOURCE_PASSWORD=splitwise
